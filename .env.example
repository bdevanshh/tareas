# ============================================================================
# Tareas — single root environment file
# Copy to .env (gitignored) and edit. Both the backend and frontend read this
# file (backend via godotenv, frontend via Vite's envDir).
# ============================================================================

# ----------------------------------------------------------------------------
# Backend (koanf reads TAREAS_* from the process environment; dots are part of
# the variable name and map to nested config keys).
# ----------------------------------------------------------------------------
TAREAS_PRIMARY.ENV="local"

TAREAS_SERVER.PORT="3001"
TAREAS_SERVER.READ_TIMEOUT="30"
TAREAS_SERVER.WRITE_TIMEOUT="30"
TAREAS_SERVER.IDLE_TIMEOUT="60"
TAREAS_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3000"

TAREAS_DATABASE.HOST="postgres"
TAREAS_DATABASE.PORT="5432"
TAREAS_DATABASE.USER="postgres"
TAREAS_DATABASE.PASSWORD="secret"
TAREAS_DATABASE.NAME="tareas"
TAREAS_DATABASE.SSL_MODE="disable"
TAREAS_DATABASE.MAX_OPEN_CONNS="25"
TAREAS_DATABASE.MAX_IDLE_CONNS="25"
TAREAS_DATABASE.CONN_MAX_LIFETIME="300"
TAREAS_DATABASE.CONN_MAX_IDLE_TIME="300"

# Replace with a real Clerk secret key (same instance as the publishable key).
TAREAS_AUTH.SECRET_KEY="sk_test_local_development"

# Dummy value is enough to boot locally. Set a real Resend key to send email.
TAREAS_INTEGRATION.RESEND_API_KEY="re_local_development"

TAREAS_REDIS.ADDRESS="redis:6379"
TAREAS_REDIS.PASSWORD=""
TAREAS_REDIS.TLS_ENABLED="false"

TAREAS_AWS.REGION="us-east-1"
TAREAS_AWS.ACCESS_KEY_ID="test"
TAREAS_AWS.SECRET_ACCESS_KEY="test"
TAREAS_AWS.UPLOAD_BUCKET="tareas-todo-attachments"
# Endpoint used by the backend (localhost when running natively).
TAREAS_AWS.ENDPOINT_URL="http://seaweedfs:8333"
# Endpoint embedded in presigned URLs opened by the browser.
TAREAS_AWS.PUBLIC_ENDPOINT_URL="http://localhost:8333"

TAREAS_OBSERVABILITY.SERVICE_NAME="tareas"
TAREAS_OBSERVABILITY.ENVIRONMENT="development"
TAREAS_OBSERVABILITY.LOGGING.LEVEL="debug"
TAREAS_OBSERVABILITY.LOGGING.FORMAT="json"
TAREAS_OBSERVABILITY.NEW_RELIC.LICENSE_KEY=""
TAREAS_OBSERVABILITY.NEW_RELIC.USER_KEY=""
TAREAS_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="true"
TAREAS_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="true"
TAREAS_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

TAREAS_CRON.CRON_SECRET="cron_secret"
TAREAS_CRON.ARCHIVE_DAYS_THRESHOLD=30
TAREAS_CRON.BATCH_SIZE=100
TAREAS_CRON.REMINDER_HOURS=24
TAREAS_CRON.MAX_TODOS_PER_USER_NOTIFICATION=10

# ----------------------------------------------------------------------------
# Frontend (Vite)
# ----------------------------------------------------------------------------
VITE_API_URL="http://localhost:3001/api/v1"
# Public Clerk publishable key. Replace with your own app's key if needed.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_Z2xvd2luZy1sZWVjaC05LmNsZXJrLmFjY291bnRzLmRldiQ
