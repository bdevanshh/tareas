{
  "name": "tareas",
  "private": true,
  "scripts": {
    "dev": "docker compose up --build",
    "dev:host": "([ -f .env.local ] || cp .env.local.example .env.local) && docker compose up -d --wait postgres redis seaweedfs && turbo run dev",
    "dev:down": "docker compose down",
    "dev:logs": "docker compose logs -f",
    "dev:reset": "docker compose down -v",
    "db:migrate": "docker compose run --rm migrate",
    "db:shell": "docker compose exec postgres psql -U postgres -d tareas",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.12",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
