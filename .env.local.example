# Host-development overrides. Used only when running the backend on the host
# (bun dev:host); Docker uses the container hostnames from .env.
# Copy to .env.local (gitignored):  cp .env.local.example .env.local
TAREAS_DATABASE.HOST="localhost"
TAREAS_REDIS.ADDRESS="localhost:6379"
TAREAS_AWS.ENDPOINT_URL="http://localhost:8333"
